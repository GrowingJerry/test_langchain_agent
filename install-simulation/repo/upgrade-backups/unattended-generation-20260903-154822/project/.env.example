OLLAMA_REVIEW_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=qwen2.5vl:3b
TEXT_MODEL=qwen3:8b
VISION_MODEL=qwen2.5vl:3b
REQUIREMENT_ATOMIZER_MODEL=qwen3:8b
REQUIREMENT_AUDITOR_MODEL=qwen3:8b
PAGE_UNDERSTANDING_MODEL=qwen2.5vl:3b
TEST_CASE_MODEL=qwen3:8b
