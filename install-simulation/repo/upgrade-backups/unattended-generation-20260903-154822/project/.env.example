PLAYWRIGHT_RENDER_MAX_VISIBLE_TEXT_CHARS=20000
PLAYWRIGHT_RENDER_MAX_DOM_CHARS=50000
PLAYWRIGHT_SCREENSHOT_ENABLED=true
PLAYWRIGHT_VIEWPORT_WIDTH=1366
PLAYWRIGHT_VIEWPORT_HEIGHT=768
# Retrieval
GENERATION_MAX_HISTORY_EXAMPLES=2
GENERATION_MAX_RELATED_CHUNKS=3
GENERATION_MAX_RELATED_CHUNK_CHARS=1200
GENERATION_MAX_PAGE_OBSERVATIONS=20
# General extraction
GENERAL_EXTRACTION_BLOCK_CHARS=12000
GENERAL_EXTRACTION_GROUP_CHARS=24000
GENERAL_EXTRACTION_NUM_PREDICT=4096
GENERAL_EXTRACTION_TIMEOUT=300

# 小测桌面智能体（全部为本机离线能力）
XIAOCHE_ENABLED=true
XIAOCHE_APP_URL=http://127.0.0.1:8501
XIAOCHE_ALWAYS_ON_TOP=true
XIAOCHE_AUTO_DOCK=true
