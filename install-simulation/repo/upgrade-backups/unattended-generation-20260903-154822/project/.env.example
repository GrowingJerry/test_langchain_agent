AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_MODEL_MAX_RETRIES=2
AGENT_TOOL_MAX_RETRIES=1
STRUCTURED_OUTPUT_MAX_RETRIES=2
ENABLE_STREAMING=false
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
+# Stable case identifiers
CASE_ID_SEQUENCE_WIDTH=4
CASE_ID_FALLBACK_PREFIX=REQ
CASE_ID_REUSE_DELETED_SEQUENCE=false
# Generation budget and guards
GENERATION_CONTEXT_TOKEN_BUDGET=6000
GENERATION_OUTPUT_TOKEN_RESERVE=4096
GENERATION_CONTEXT_SAFETY_RATIO=0.85
GENERATION_PROMPT_OVERHEAD_TOKENS=1600
GENERATION_EXPECTED_TOKENS_PER_CASE=900
GENERATION_EXPECTED_OUTPUT_BASE_TOKENS=350
GENERATION_MAX_CASES_PER_REQUIREMENT=10
# Deprecated compatibility setting above; atomic coverage uses the settings below.
GENERATION_MIN_CASES_PER_ATOM=4
GENERATION_DEFAULT_MAX_CASES_PER_ATOM=10
GENERATION_ABSOLUTE_MAX_CASES_PER_ATOM=20
GENERATION_MAX_CASES_PER_MODEL_CALL=2
GENERATION_AUTO_BATCH_ENABLED=true
GENERATION_COVERAGE_REPAIR_ENABLED=true
GENERATION_COVERAGE_REPAIR_MAX_ROUNDS=2
GENERATION_HARD_MAX_CASES_PER_REQUIREMENT=500
GENERATION_MAX_OUTPUT_CHARS=200000
GENERATION_MAX_STEP_CHARS=2000
GENERATION_MAX_FIELD_CHARS=12000
GENERATION_MAX_SECONDS=600
GENERATION_MODEL_CALL_MAX_SECONDS=3600
GENERATION_IDLE_TIMEOUT_SECONDS=600
GENERATION_BATCH_MAX_SECONDS=0
GENERATION_JOB_LEASE_SECONDS=300
GENERATION_JOB_MAX_ATTEMPTS=20
GENERATION_JOB_RETRY_DELAY_SECONDS=30
GENERATION_WORKER_IDLE_EXIT_SECONDS=120
GENERATION_REPETITION_GUARD_ENABLED=true
GENERATION_REPEAT_WINDOW_CHARS=160
GENERATION_REPEAT_THRESHOLD=4
GENERATION_MAX_SAME_CHAR_RUN=24
GENERATION_MAX_DIGIT_RUN=32
GENERATION_JSON_PROGRESS_TIMEOUT_SECONDS=90
GENERATION_UI_POLL_INTERVAL_MS=500
GENERATION_UI_STREAM_DISPLAY_CHARS=6000
# HTML / binding evidence limits
HTML_MAX_TOTAL_ELEMENTS=5000
HTML_MAX_ELEMENTS_PER_PAGE=100
HTML_MAX_CANDIDATE_PAGES=5
HTML_MAX_VISIBLE_TEXT_CHARS=8000
HTML_MAX_ELEMENT_TEXT_CHARS=240
HTML_MAX_ATTRIBUTE_CHARS=240
HTML_MAX_PAGE_REGIONS=50
HTML_MAX_FORMS=50
HTML_MAX_TABLES=50
HTML_MAX_DIALOGS=50
BINDING_AUTO_CONFIRM_THRESHOLD=0.8
BINDING_MAX_CANDIDATE_PAGES=5
BINDING_MAX_ELEMENT_IDS=10
BINDING_MODEL_NUM_PREDICT=2000
BINDING_MODEL_TIMEOUT=120
BINDING_REASON_MAX_CHARS=500
AUDIT_REASON_MAX_CHARS=1000
# Central evidence policy
HTML_EVIDENCE_FUNCTIONAL=strong
HTML_EVIDENCE_UI=strong
HTML_EVIDENCE_USABILITY=strong
HTML_EVIDENCE_COMPATIBILITY=medium
HTML_EVIDENCE_SECURITY=partial
HTML_EVIDENCE_PERFORMANCE=weak
HTML_EVIDENCE_INTERFACE=off
HTML_EVIDENCE_RELIABILITY=trigger_only
# Runtime logs
RUN_LOG_RETENTION_DAYS=30
RUN_LOG_MAX_FILES=500
RUN_LOG_MAX_FILE_BYTES=2000000
RUN_LOG_SAVE_MODEL_REQUEST=true
RUN_LOG_SAVE_MODEL_RESPONSE=true
RUN_LOG_REDACT_SENSITIVE_DATA=true
+# Playwright evidence
PLAYWRIGHT_MAX_OBSERVATIONS=50
PLAYWRIGHT_MAX_OBSERVATION_TEXT_CHARS=10000
