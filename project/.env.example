GENERATION_REPEAT_THRESHOLD=4
GENERATION_MAX_SAME_CHAR_RUN=24
GENERATION_MAX_DIGIT_RUN=32
GENERATION_JSON_PROGRESS_TIMEOUT_SECONDS=90
GENERATION_UI_POLL_INTERVAL_MS=500
